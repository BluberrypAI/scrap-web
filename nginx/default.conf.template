# nginx 공식 이미지가 시작할 때 환경 변수(${SCRAP_SERVER_URL})를 치환해 default.conf로 만든다.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # 화면 코드는 같은 출처의 /api 만 호출하므로 서버 API로 그대로 전달
    # Host는 server 주소로 넘김: Azure App Service는 Host로 앱을 찾으므로 화면 주소를 넘기면 server에 닿지 않음
    location /api/ {
        # 여러 업체의 순차 AI 검토가 기본 60초에 잘리지 않게 한다.
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 600s;
        # 서버 컨테이너 재생성으로 IP가 바뀌어도 런타임 DNS로 다시 찾는다.
        set $scrap_backend ${SCRAP_SERVER_URL};
        proxy_pass $scrap_backend;
        proxy_set_header Host $proxy_host;
        # server가 https 주소일 때 TLS 이름(SNI)을 같이 보냄
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 빌드 산출물은 파일명에 해시가 붙어 있어 오래 캐시해도 됨
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 해시 라우팅이라 index.html 하나로 모든 화면을 연다
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
